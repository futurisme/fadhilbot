# ================================================================
# KONFIGURASI DISCORD 24/7 AUDIO-PRIORITY & 480p STREAM ENGINE (2026)
# ================================================================

DISCORD_TOKEN=MASUKKAN_TOKEN_DISCORD_ANDA_DISINI
PORT=3000

# Voice 24/7 Channel Target
VOICE_CHANNEL_ID=1366441630151737445
VOICE_GUILD_ID=1323944038117675038
VOICE_AUTO_REJOIN=true
VOICE_REJOIN_DELAY_SEC=8

# Engine Prioritas Audio & 480p Video Screen-Share (Loop: Gradation -> Aizo)
ENABLE_STREAM=true
AUTO_LOOP=true
VIDEO_RESOLUTION=480p
VIDEO_WIDTH=854
VIDEO_HEIGHT=480
VIDEO_FPS=30
VIDEO_BITRATE=900
AUDIO_BITRATE=192
AUDIO_BOOST=1.35
AUDIO_PRIORITY=true
FFMPEG_THREADS=3

# Anti-Deteksi Discord: Jeda Istirahat 1-2 Menit Setiap 2 Jam
TWO_HOUR_BREAK_ENABLED=true
BREAK_INTERVAL_MINUTES=120
BREAK_DURATION_SECONDS=90

