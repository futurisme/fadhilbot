DISCORD_TOKEN=MASUKKAN_TOKEN_DISCORD_ANDA_DISINI
PORT=3000

# Voice 24/7 Channel Target
VOICE_CHANNEL_ID=1366441630151737445
VOICE_GUILD_ID=1323944038117675038
VOICE_AUTO_REJOIN=true
VOICE_REJOIN_DELAY_SEC=8

# Engine Prioritas Audio On-Mic & Adaptive 360p-480p Screen-Share (Loop: Gradation -> Aizo)
ENABLE_STREAM=true
AUTO_LOOP=true
VIDEO_RESOLUTION_MIN=360p
VIDEO_RESOLUTION_MAX=480p
VIDEO_WIDTH=854
VIDEO_HEIGHT=480
VIDEO_FPS_MIN=22
VIDEO_FPS_MAX=24
VIDEO_FPS=24
VIDEO_BITRATE=550
VIDEO_BITRATE_MAX=680
AUDIO_BITRATE=192
AUDIO_BOOST=1.48
AUDIO_PRIORITY=extreme_zero_drop
AUDIO_COMPUTE_MAXIMIZED=true
ADAPTIVE_VIDEO_DISCRIMINATION=true
FFMPEG_THREADS=4

# Anti-Deteksi Discord: Jeda Istirahat 1-2 Menit Setiap 2 Jam
TWO_HOUR_BREAK_ENABLED=true
BREAK_INTERVAL_MINUTES=120
BREAK_DURATION_SECONDS=90

